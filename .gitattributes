# Normalize line endings across machines. Without this, editing files on
# Windows (CRLF) vs files authored on Linux (LF) produces phantom "modified"
# diffs that block git pull --rebase and force the stash dance.
#
# `text=auto` lets git decide what's text; `eol=lf` stores LF in the repo.
# Working-tree checkout still respects core.autocrlf for the editor, but the
# committed blob is always LF, so diffs are deterministic.

* text=auto eol=lf

# Explicitly mark the source files as LF text
*.html  text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.css    text eol=lf
*.ps1    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf

# Binary files — never touch line endings
*.png    binary
*.gif    binary
*.ico    binary
*.jpg    binary
*.jpeg   binary
*.webp   binary
*.woff   binary
*.woff2  binary
