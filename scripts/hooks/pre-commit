#!/bin/sh
# Guard against the two ways UI work has nearly been lost in this repo.
#
# The deploy rule is: UI changes are made on `staging` and promoted to `main` by
# taking staging's index.html wholesale. Nothing enforced that, and drifting onto
# main is easy — the promote itself ends with the repo checked out on main, so the
# NEXT session starts there by default.
#
# What actually went wrong (2026-08-15): index.html was edited on main, and
# copying that file across to staging would have silently reverted four commits
# of staging work, because main's copy predated them. It was caught by reading a
# diff stat. This hook removes the reliance on noticing.
#
# Bypass for a genuine promote:  JD_PROMOTE=1 git commit ...
# (scripts/promote-to-live.sh sets it for you.)
#
# Installed via:  git config core.hooksPath scripts/hooks

branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

# --- test-data tripwire (all branches, no bypass) ---------------------------
# Fabricated data gets staged deliberately to preview a feature before its real
# data exists, and the only thing standing between that and production is
# someone remembering to take it out. Anything carrying the _TESTDATA marker is
# refused at the commit boundary on main, and merely warned about on staging so
# the preview still works.
staged_test=$(git diff --cached --name-only --diff-filter=ACM | while read -r f; do
  # Match the JSON KEY, not any mention of the word — this script names the
  # marker itself and must not flag its own source.
  [ -f "$f" ] && grep -Elq '"_TESTDATA"[[:space:]]*:' "$f" 2>/dev/null && echo "$f"
done)
if [ -n "$staged_test" ]; then
  if [ "$branch" = "main" ]; then
    echo >&2
    echo >&2 "  BLOCKED: fabricated test data is staged on \`main\`:"
    echo >&2 "$staged_test" | sed >&2 's/^/      /'
    echo >&2
    echo >&2 "  These files carry the \"_TESTDATA\" marker. Restore the real data before"
    echo >&2 "  committing:   git checkout origin/main -- <file>"
    echo >&2
    exit 1
  fi
  echo >&2 "  NOTE: committing files marked \"_TESTDATA\" to \`$branch\` (preview only):"
  echo >&2 "$staged_test" | sed >&2 's/^/      /'
  echo >&2 "  These can never reach main — the hook blocks them there."
fi

[ "$branch" = "main" ] || exit 0
[ -n "$JD_PROMOTE" ] && exit 0

staged_ui=$(git diff --cached --name-only | grep -E '^public/index\.html$' || true)
[ -z "$staged_ui" ] && exit 0

cat >&2 <<'MSG'

  BLOCKED: public/index.html is staged on `main`.

  UI changes belong on `staging`, then get promoted. Committing them straight to
  main skips review and — worse — leaves main's copy ahead of staging, so the
  next promote silently reverts whatever staging had.

  To move this work to staging instead:

      cp public/index.html /tmp/wip.html
      git checkout -- public/index.html
      git checkout staging && git pull --rebase origin staging
      cp /tmp/wip.html public/index.html
      git diff --stat          # sanity-check: should be small and additive

  To promote staging to live (the only legitimate index.html commit on main):

      ./scripts/promote-to-live.sh

MSG
exit 1
